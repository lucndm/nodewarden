{
  "name": "nodewarden",
  "version": "1.8.2",
  "description": "Minimal Bitwarden-compatible server running on Cloudflare Workers",
  "author": "shuaiplus",
  "license": "LGPL-3.0",
  "main": "src/index.ts",
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "scripts": {
    "dev": "wrangler dev -c wrangler.toml",
    "dev:kv": "wrangler dev -c wrangler.kv.toml",
    "dev:demo": "vite --config webapp/vite.config.ts --mode demo --host 127.0.0.1 --port 5174",
    "build": "vite build --config webapp/vite.config.ts",
    "build:demo": "vite build --config webapp/vite.config.ts --mode demo && node scripts/pages-spa-redirects.cjs",
    "domains:sync": "node scripts/sync-global-domains.mjs",
    "i18n": "node scripts/i18n-validate.cjs",
    "i18n:validate": "node scripts/i18n-validate.cjs",
    "test:config-compatibility": "tsx --test scripts/config-compatibility.test.ts",
    "test:vault-compatibility": "tsx --tsconfig webapp/tsconfig.json --import ./scripts/offline-workers-loader.mjs --test scripts/vault-compatibility.test.ts",
    "test:folder-legacy-encryption": "tsx --tsconfig webapp/tsconfig.json --import ./scripts/offline-workers-loader.mjs --test scripts/folder-legacy-encryption.test.ts",
    "inventory:folders": "tsx --tsconfig webapp/tsconfig.json scripts/folder-plaintext-inventory.ts",
    "test:folder-inventory": "tsx --tsconfig webapp/tsconfig.json --import ./scripts/offline-workers-loader.mjs --test scripts/folder-plaintext-inventory.test.ts",
    "test:folder-tag-backup": "tsx --tsconfig webapp/tsconfig.json --import ./scripts/offline-workers-loader.mjs --test scripts/folder-tag-backup.test.ts",
    "test:sends": "tsx --tsconfig webapp/tsconfig.json --import ./scripts/offline-workers-loader.mjs --test scripts/sends.test.ts",
    "test:account-protection": "tsx --tsconfig webapp/tsconfig.json --import ./scripts/offline-workers-loader.mjs --test scripts/account-protection.test.ts",
    "test:audit-export": "tsx --tsconfig webapp/tsconfig.json --import ./scripts/offline-workers-loader.mjs --test scripts/audit-log-export.test.ts",
    "test:alias-forwarder": "tsx --tsconfig webapp/tsconfig.json --test scripts/alias-forwarder.test.ts",
    "test:org-policies": "tsx --tsconfig webapp/tsconfig.json --import ./scripts/offline-workers-loader.mjs --test scripts/org-policies.test.ts",
    "test:scan-exclusions": "tsx --tsconfig webapp/tsconfig.json --import ./scripts/offline-workers-loader.mjs --test scripts/scan-exclusions.test.ts",
    "test:password-security": "tsx --tsconfig webapp/tsconfig.json --import ./scripts/offline-workers-loader.mjs --test scripts/password-security.test.ts",
    "test:cipher-tags": "tsx --tsconfig webapp/tsconfig.json --import ./scripts/offline-workers-loader.mjs --test scripts/cipher-tags.test.ts",
    "test:cipher-versions": "tsx --tsconfig webapp/tsconfig.json --import ./scripts/offline-workers-loader.mjs --test scripts/cipher-versions.test.ts",
    "test:collection-access": "tsx --test scripts/collection-access.test.ts scripts/collection-access-sql.test.ts",
    "test:unit": "npm run test:org-policies && npm run test:audit-export && npm run test:alias-forwarder && npm run test:account-protection && npm run test:authed-fetch-retry && npm run test:billing-subscription && npm run test:sends && npm run test:scan-exclusions && npm run test:password-security && npm run test:cipher-tags && npm run test:cipher-usage && npm run test:cipher-usage-web && npm run test:cipher-versions && npm run test:config-compatibility && npm run test:email-breach && npm run test:folder-inventory && npm run test:folder-legacy-encryption && npm run test:relative-day-label && npm run test:folder-tag-backup && npm run test:organization-migration && npm run test:folder-collection-mapping && npm run test:icons && npm run test:master-password-hint && npm run test:notifications-security && npm run test:password-hint-endpoint-removed && npm run test:security-alerts && npm run test:sso && npm run test:sync-cipher-filter && npm run test:sync-collection-ids && npm run test:user-key-id && npm run test:vault-compatibility && npm run test:vault-secret-display && npm run test:web-crypto && npm run test:webauthn-connector && npm run test:webauthn-connectors && npm run test:webauthn-mobile",
    "test:local": "npm run test:unit && npm run test:local-cli && npm run test:local-api && npm run test:local-shared-items && npm run test:local-ui && npm run test:local-send-public && npm run test:local-extension && npm run test:collection-access && npm run test:collection-storage && npm run test:organization-rotation && npm run test:prod-vault-audit",
    "test:local-cli": "tsx --tsconfig webapp/tsconfig.json scripts/local-cli-e2e.mts",
    "test:local-extension": "tsx --tsconfig webapp/tsconfig.json scripts/local-extension-e2e.mts",
    "test:local-api": "node scripts/local-api-e2e.mjs",
    "test:local-shared-items": "node scripts/local-shared-items-e2e.mjs",
    "test:sync-collection-ids": "tsx --tsconfig webapp/tsconfig.json --import ./scripts/offline-workers-loader.mjs --test scripts/sync-collection-ids.test.ts",
    "test:local-ui": "tsx --tsconfig webapp/tsconfig.json scripts/local-ui-e2e.mts",
    "test:local-restore": "tsx --tsconfig webapp/tsconfig.json scripts/local-restore-rehearsal.mts",
    "test:web-crypto": "tsx --test scripts/web-crypto-availability.test.ts",
    "test:authed-fetch-retry": "tsx --tsconfig webapp/tsconfig.json --import ./scripts/offline-workers-loader.mjs --test scripts/authed-fetch-retry.test.ts",
    "test:user-key-id": "tsx --tsconfig webapp/tsconfig.json --import ./scripts/offline-workers-loader.mjs --test scripts/user-key-id.test.ts",
    "test:cipher-usage": "tsx --tsconfig webapp/tsconfig.json --import ./scripts/offline-workers-loader.mjs --test scripts/cipher-usage.test.ts",
    "test:cipher-usage-web": "tsx --tsconfig webapp/tsconfig.json --import ./scripts/offline-workers-loader.mjs --test scripts/cipher-usage-web.test.ts",
    "test:vault-secret-display": "tsx --tsconfig webapp/tsconfig.json --import ./scripts/offline-workers-loader.mjs --test scripts/vault-secret-display.test.ts",
    "test:master-password-hint": "tsx --tsconfig webapp/tsconfig.json --import ./scripts/offline-workers-loader.mjs --test scripts/master-password-hint.test.ts",
    "test:sync-cipher-filter": "tsx --tsconfig webapp/tsconfig.json --import ./scripts/offline-workers-loader.mjs --test scripts/sync-cipher-filter.test.ts",
    "test:password-hint-endpoint-removed": "tsx --tsconfig webapp/tsconfig.json --import ./scripts/offline-workers-loader.mjs --test scripts/password-hint-endpoint-removed.test.ts",
    "test:billing-subscription": "tsx --tsconfig webapp/tsconfig.json --import ./scripts/offline-workers-loader.mjs --test scripts/billing-subscription.test.ts",
    "test:notifications-security": "tsx --test scripts/notifications-security.test.ts",
    "test:security-alerts": "tsx --tsconfig webapp/tsconfig.json --import ./scripts/offline-workers-loader.mjs --test scripts/security-alerts.test.ts scripts/security-alerts-auth.test.ts",
    "test:webauthn-mobile": "node --test scripts/webauthn-mobile-connector.test.mjs",
    "test:webauthn-connector": "node --test scripts/webauthn-connector.test.mjs && tsx --test scripts/webauthn-connector-headers.test.ts",
    "test:webauthn-connectors": "node --test scripts/webauthn-mobile-connector.test.mjs scripts/webauthn-connector.test.mjs && tsx --test scripts/webauthn-connector-headers.test.ts",
    "test:sso": "node --import tsx --require ./scripts/register-sso-test-hooks.cjs --test scripts/sso-mobile-flow.test.ts",
    "test:icons": "node --import tsx --require ./scripts/register-sso-test-hooks.cjs --test scripts/website-icon.test.ts",
    "test:email-breach": "node --import tsx --require ./scripts/register-sso-test-hooks.cjs --test scripts/email-breach-monitor.test.ts",
    "deploy": "wrangler deploy",
    "deploy:kv": "node scripts/ensure-kv.cjs && wrangler deploy -c wrangler.kv.toml",
    "deploy:demo": "npm run build:demo && wrangler pages deploy dist --project-name nw-demo",
    "audit:prod-vault": "node scripts/prod-vault-audit.mjs",
    "test:prod-vault-audit": "node scripts/prod-vault-audit.test.mjs",
    "digest:backup": "node scripts/backup-archive-digest.mjs",
    "test:collection-storage": "tsx --tsconfig webapp/tsconfig.json --import ./scripts/offline-workers-loader.mjs --test scripts/collection-storage.test.ts scripts/collection-sync-filter.test.ts scripts/organization-keys.test.ts scripts/shared-item.test.ts",
    "test:organization-rotation": "tsx --tsconfig webapp/tsconfig.json --import ./scripts/offline-workers-loader.mjs --test scripts/organization-key-rotation.test.ts",
    "test:backup-archive-encryption": "tsx --tsconfig webapp/tsconfig.json --import ./scripts/offline-workers-loader.mjs --test scripts/backup-archive-encryption.test.ts",
    "test:organization-migration": "tsx --tsconfig webapp/tsconfig.json --import ./scripts/offline-workers-loader.mjs --test scripts/organization-migration.test.ts",
    "test:folder-collection-mapping": "tsx --tsconfig webapp/tsconfig.json --import ./scripts/offline-workers-loader.mjs --test scripts/folder-collection-mapping.test.ts",
    "test:local-send-public": "tsx --tsconfig webapp/tsconfig.json scripts/local-send-public-e2e.mts",
    "test:relative-day-label": "tsx --tsconfig webapp/tsconfig.json --import ./scripts/offline-workers-loader.mjs --test scripts/relative-day-label.test.ts"
  },
  "keywords": [
    "bitwarden",
    "vaultwarden",
    "cloudflare",
    "workers",
    "password-manager"
  ],
  "cloudflare": {
    "bindings": {
      "JWT_SECRET": {
        "description": "Use a strong random string (32+ characters recommended)"
      },
      "DB": {
        "description": "D1 database for storing vault data"
      },
      "ATTACHMENTS": {
        "description": "R2 bucket for storing file attachments"
      },
      "ATTACHMENTS_KV": {
        "description": "Optional KV namespace fallback for attachment/send-file storage"
      }
    }
  },
  "overrides": {
    "nanoid": "3.3.18",
    "undici": "8.12.4",
    "@babel/core": ">=7.29.6",
    "esbuild": ">=0.28.1",
    "ws": "8.21.0",
    "sharp": "0.35.5",
    "browserslist": "4.28.7",
    "baseline-browser-mapping": "2.11.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "opencc-js": "^1.4.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.146.0"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@simplewebauthn/server": "^14.0.3",
    "@tanstack/react-query": "^5.105.1",
    "@zip.js/zip.js": "^2.24.0",
    "fflate": "^0.8.3",
    "jsqr": "1.4.0",
    "lucide-preact": "^1.66.0",
    "preact": "^10.29.3",
    "qrcode-generator": "^2.0.4",
    "wouter": "^3.13.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20261001.1": true
  }
}
