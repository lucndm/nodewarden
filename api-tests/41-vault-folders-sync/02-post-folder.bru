meta {
  name: POST folders
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/folders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerToken}}
}

body:json {
  {
    "name": "2.aXYtZm9sZGVyLWE=|Y3QtZm9sZGVyLWE=|bWFjLWZm9sZGVyLWE="
  }
}

script:post-response {
  bru.setVar("folderAId", res.body && res.body.id);
}

docs {
  Client: `FolderApiService.postFolder` (`libs/common/src/vault/services/folder/folder-api.service.ts`), body `FolderRequest` (`name`,
  encrypted), read as `FolderResponse` (Id, Name, RevisionDate).
}

tests {
  test("the owner creates a folder", function () {
    expect(res.status).to.equal(200);
    expect(res.body.id).to.be.a("string");
    expect(res.body.name).to.equal(req.getBody().name);
    expect(res.body.revisionDate).to.be.a("string");
  });
}
