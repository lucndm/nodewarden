meta {
  name: GET sync
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/sync
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ownerToken}}
}

docs {
  Client: `ApiService.getSync` (`libs/common/src/services/api.service.ts`), read as
  `SyncResponse`: Profile, Folders, Collections, Ciphers, Domains, Policies,
  Sends, UserDecryption. Clients that cannot autofill ask for
  `?excludeDomains=true`.
}

tests {
  test("the owner syncs", function () {
    expect(res.status).to.equal(200);
  });
  test("the sync has every part the client reads", function () {
    for (const part of ["profile", "folders", "collections", "ciphers", "policies", "sends"]) {
      expect(res.body, part).to.have.property(part);
    }
    expect(res.body.domains).to.be.an("object");
  });
  test("the sync carries the user decryption options", function () {
    expect(res.body.userDecryption).to.be.an("object");
  });
  test("the new folder is in the sync", function () {
    const ids = (res.body.folders || []).map((folder) => folder.id);
    expect(ids).to.include(bru.getVar("folderAId"));
  });
}
