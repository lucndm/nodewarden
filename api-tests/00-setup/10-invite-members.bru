meta {
  name: Invite the member and the invitee
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/organizations/{{orgId}}/users
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerToken}}
}

body:json {
  {
    "emails": ["{{memberEmail}}", "{{inviteeEmail}}"],
    "type": 2
  }
}

tests {
  test("both accounts are invited", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data).to.have.lengthOf(2);
  });
}
