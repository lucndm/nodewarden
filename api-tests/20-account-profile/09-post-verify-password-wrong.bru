meta {
  name: POST verify-password with a wrong password
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/accounts/verify-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerToken}}
}

body:json {
  {
    "masterPasswordHash": "{{wrongPasswordHash}}"
  }
}

tests {
  test("a wrong password is refused", function () {
    expect(res.status).to.equal(400);
  });
}
