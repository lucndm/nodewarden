meta {
  name: PUT profile
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/api/accounts/profile
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerToken}}
}

body:json {
  {
    "name": "Contract Owner Renamed"
  }
}

docs {
  Client: `ApiService.putProfile`, body `UpdateProfileRequest` (`name`),
  read as `ProfileResponse`.

  Reference: vaultwarden `put_profile`.
}

tests {
  test("the owner renames the account", function () {
    expect(res.status).to.equal(200);
    expect(res.body.name).to.equal("Contract Owner Renamed");
  });
}
