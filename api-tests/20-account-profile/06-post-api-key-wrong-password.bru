meta {
  name: POST api-key with a wrong password
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/accounts/api-key
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerToken}}
}

body:json {
  {
    "masterPasswordHash": "{{wrongPasswordHash}}"
  }
}

docs {
  The API key is a login secret, so the master password check must hold.
}

tests {
  test("a wrong password does not reveal the API key", function () {
    expect(res.status).to.equal(400);
  });
}
