meta {
  name: POST verify-password
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/accounts/verify-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerToken}}
}

body:json {
  {
    "masterPasswordHash": "{{ownerPasswordHash}}"
  }
}

docs {
  Client: `UserVerificationApiService.postAccountVerifyPassword`
  (`libs/common/src/auth/services/user-verification/user-verification-api.service.ts`),
  body `SecretVerificationRequest`, read as `MasterPasswordPolicyResponse`
  (the master password policy of the account's organizations, may be empty).

  Reference: vaultwarden `verify_password` refuses "Invalid password".
}

tests {
  test("the right password is accepted", function () {
    expect(res.status).to.equal(200);
  });
}
