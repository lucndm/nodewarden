meta {
  name: GET revision date
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/accounts/revision-date
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ownerToken}}
}

docs {
  Client: `ApiService.getAccountRevisionDate` returns the body as a number: Unix
  milliseconds. The client compares it with its last sync to decide whether to
  sync again.

  Reference: vaultwarden `revision_date` answers `timestamp_millis()` as a bare JSON number.
}

tests {
  test("the revision date is a bare number of milliseconds", function () {
    expect(res.status).to.equal(200);
    expect(res.body).to.be.a("number");
    expect(res.body).to.be.above(1600000000000);
  });
}
