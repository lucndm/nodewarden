meta {
  name: POST prelogin/password
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/identity/accounts/prelogin/password
  body: json
  auth: none
}

body:json {
  {
    "email": "{{ownerEmail}}"
  }
}

docs {
  Client: `PasswordPreloginApiService.getPreloginData`
  (`libs/common/src/auth/password-prelogin/password-prelogin-api.service.ts`),
  sent to the identity URL without a token. Read as
  `PasswordPreloginResponse`: KdfSettings (KdfType, Iterations, Memory,
  Parallelism) and Salt.

  Reference: vaultwarden `prelogin_password` in `src/api/identity.rs`.
}

tests {
  test("prelogin answers without a token", function () {
    expect(res.status).to.equal(200);
  });
  test("prelogin returns the KDF settings", function () {
    expect(res.body.kdfSettings).to.be.an("object");
    expect(res.body.kdfSettings.kdfType).to.equal(0);
    expect(res.body.kdfSettings.iterations).to.equal(600000);
  });
  test("prelogin returns a salt or null", function () {
    expect(res.body).to.have.property("salt");
    expect(res.body.salt === null || typeof res.body.salt === "string").to.equal(true);
  });
}
