meta {
  name: GET policies
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/organizations/{{adminOrgId}}/policies
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ownerToken}}
}

docs {
  Client: `PolicyApiService` (`libs/common/src/admin-console/services/policy/policy-api.service.ts`). `getPolicies`, read as a list of `PolicyResponse`: Id, OrganizationId,
  Type, Data, Enabled, RevisionDate, CanToggleState.
}

tests {
  const f = (o, k) => (o == null ? undefined : o[k] !== undefined ? o[k] : o[k.charAt(0).toUpperCase() + k.slice(1)]);
  test("the owner lists the policies", function () {
    expect(res.status).to.equal(200);
    expect(f(res.body, "data")).to.be.an("array");
  });
}
