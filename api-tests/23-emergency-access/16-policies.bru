meta {
  name: GET :id/policies
  type: http
  seq: 16
}

get {
  url: {{baseUrl}}/api/emergency-access/{{emergencyAccessId}}/policies
  body: none
  auth: bearer
}

auth:bearer {
  token: {{memberToken}}
}

docs {
  Client: `getEmergencyGrantorPolicies`, read as a list of policies. A takeover
  must respect the grantor's master password policy, so the client asks only
  for a takeover access. This access is of type 0 (view), so it is refused.
  Reference: vaultwarden `policies_emergency_access` requires a takeover access that was approved.
  Vaultwarden answers 400, NodeWarden 404; the client treats both as an error.
}

tests {
  test("a view-only contact cannot read the grantor's policies", function () {
    expect(res.status).to.be.oneOf([400, 404]);
  });
}
