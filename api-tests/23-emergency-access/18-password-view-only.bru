meta {
  name: POST :id/password on a view-only access
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/api/emergency-access/{{emergencyAccessId}}/password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{memberToken}}
}

body:json {
  {
    "authenticationData": {
      "salt": "{{ownerEmail}}",
      "kdf": {
        "kdfType": 0,
        "iterations": 600000
      },
      "masterPasswordAuthenticationHash": "bmV3"
    },
    "unlockData": {
      "salt": "{{ownerEmail}}",
      "kdf": {
        "kdfType": 0,
        "iterations": 600000
      },
      "masterKeyWrappedUserKey": "2.aXY=|Y3Q=|bWFj"
    }
  }
}

docs {
  Client: `postEmergencyAccessPassword`, body `EmergencyAccessPasswordRequest`
  (`authenticationData`, `unlockData`): the grantee sets a new master password
  for the grantor.
}

tests {
  test("a view-only contact cannot set the grantor's password", function () {
    expect(res.status).to.equal(400);
  });
}
