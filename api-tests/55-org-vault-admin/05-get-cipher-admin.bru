meta {
  name: GET ciphers/:id/admin
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/ciphers/{{adminItemId}}/admin
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ownerToken}}
}

docs {
  Client: `ApiService.getCipherAdmin` (TypeScript), read as `CipherResponse`.
}

tests {
  const f = (o, k) => (o == null ? undefined : o[k] !== undefined ? o[k] : o[k.charAt(0).toUpperCase() + k.slice(1)]);
  test("the owner reads the item as an admin", function () {
    expect(res.status).to.equal(200);
  });
  test("the answer is a cipher the SDK can read", function () {
    expect(f(res.body, "id")).to.be.a("string");
    expect(f(res.body, "type")).to.equal(1);
    expect(f(res.body, "creationDate")).to.be.a("string");
    expect(f(res.body, "revisionDate")).to.be.a("string");
  });
}
