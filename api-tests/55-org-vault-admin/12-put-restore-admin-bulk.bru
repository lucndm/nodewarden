meta {
  name: PUT ciphers/restore-admin (bulk)
  type: http
  seq: 12
}

put {
  url: {{baseUrl}}/api/ciphers/restore-admin
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerToken}}
}

body:json {
  {
    "ids": [
      "{{adminItemId}}"
    ],
    "organizationId": "{{adminOrgId}}"
  }
}

docs {
  Client: the Rust SDK admin cipher client
  (`crates/bitwarden-vault/src/cipher/cipher_client/admin/`), used by the admin
  console vault, where an owner or admin acts on any item of the organization.

  `put_restore_many_admin`, body `CipherBulkRestoreRequestModel`.
}

tests {
  test("the owner restores items in bulk from the admin console", function () {
    expect([200, 204]).to.include(res.status);
  });
}
