meta {
  name: GET ciphers/organization-details
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/ciphers/organization-details?organizationId={{adminOrgId}}&includeMemberItems=false
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ownerToken}}
}

docs {
  Client: the Rust SDK admin cipher client
  (`crates/bitwarden-vault/src/cipher/cipher_client/admin/`), used by the admin
  console vault, where an owner or admin acts on any item of the organization.

  `get_organization_ciphers`, query `organizationId`, `includeMemberItems`, read
  as a list of `CipherMiniDetailsResponseModel` (a cipher with `collectionIds`).
}

tests {
  const f = (o, k) => (o == null ? undefined : o[k] !== undefined ? o[k] : o[k.charAt(0).toUpperCase() + k.slice(1)]);
  test("the owner lists every item of the organization", function () {
    expect(res.status).to.equal(200);
    const ids = (f(res.body, "data") || []).map((row) => f(row, "id"));
    expect(ids).to.include(bru.getVar("adminItemId"));
  });
}
