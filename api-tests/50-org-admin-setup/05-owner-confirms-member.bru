meta {
  name: The owner confirms the member
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/organizations/{{adminOrgId}}/users/{{adminMemberMid}}/confirm
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerToken}}
}

body:json {
  {
    "key": "{{wrappedOrgKey}}"
  }
}

tests {
  test("the member is confirmed", function () {
    expect(res.status).to.equal(200);
  });
}
