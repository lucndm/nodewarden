meta {
  name: POST password-hint
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/accounts/password-hint
  body: json
  auth: none
}

body:json {
  {
    "email": "{{ownerEmail}}"
  }
}

docs {
  Client: `ApiService.postPasswordHint`, body `PasswordHintRequest` (`email`),
  sent without a token.

  NodeWarden decision: the route was removed on 2026-10-16 because it disclosed
  the hint to anyone who knew the email. `scripts/password-hint-endpoint-removed.test.ts`
  guards it. Without a token the request ends in 401.
}

tests {
  test("NodeWarden never discloses a hint", function () {
    expect(res.status).to.not.equal(200);
    expect(JSON.stringify(res.body || "")).to.not.include("masterPasswordHint");
  });
}
