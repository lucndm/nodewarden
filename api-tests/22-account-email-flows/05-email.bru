meta {
  name: POST email (finish an email change)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/accounts/email
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerToken}}
}

body:json {
  {
    "masterPasswordHash": "{{ownerPasswordHash}}",
    "newEmail": "contract-owner-new@example.test",
    "newMasterPasswordHash": "bmV3",
    "token": "000000",
    "key": "2.aXY=|Y3Q=|bWFj"
  }
}

docs {
  Client: `DefaultChangeEmailService`, body `EmailRequest`: `newEmail`,
  `masterPasswordHash`, `newMasterPasswordHash`, `token` (the emailed code),
  `key`, or `authenticationData` and `unlockData`. The email is the salt, so
  the client re-derives the master key and sends the rewrapped user key.

  NodeWarden serves this route when outbound mail is configured (EMAIL binding and MAIL_FROM); without it the answer is 501. The local test worker has the binding but cannot deliver, so the code request answers 429 and nothing is pending.
}

tests {
  test("without a pending code the change is refused", function () {
    expect(res.status).to.equal(400);
    expect(res.body.error).to.contain("No email change pending");
  });
}
