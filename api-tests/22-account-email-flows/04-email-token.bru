meta {
  name: POST email-token (start an email change)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/accounts/email-token
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerToken}}
}

body:json {
  {
    "masterPasswordHash": "{{ownerPasswordHash}}",
    "newEmail": "contract-owner-new@example.test"
  }
}

docs {
  Client: `DefaultChangeEmailService`
  (`libs/common/src/auth/services/change-email/default-change-email.service.ts`),
  body `EmailTokenRequest` (`masterPasswordHash`, `newEmail`). The server
  emails a code to the new address.

  NodeWarden serves this route when outbound mail is configured (EMAIL binding and MAIL_FROM); without it the answer is 501. The local test worker has the binding but cannot deliver, so the code request answers 429 and nothing is pending.
}

tests {
  test("the route is served; the local worker cannot deliver the code", function () {
    expect(res.status).to.equal(429);
    expect(res.body.error).to.contain("The code could not be sent");
  });
}
