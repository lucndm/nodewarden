meta {
  name: POST delete-recover-token
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/accounts/delete-recover-token
  body: json
  auth: none
}

body:json {
  {
    "userId": "{{orgId}}",
    "token": "token"
  }
}

docs {
  Client: `ApiService.postAccountRecoverDeleteToken`, body
  `VerifyDeleteRecoverRequest` (`userId`, `token`), sent without a token.

  Mail-backed, no route.
}

tests {
  test("NodeWarden refuses on purpose: no email delivery", function () {
    expect(res.status).to.equal(501);
  });
}
