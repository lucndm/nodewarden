meta {
  name: PUT sends/:id/remove-password
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/api/sends/{{sendPasswordId}}/remove-password
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ownerToken}}
}

docs {
  Client: `SendApiService` (`libs/common/src/tools/send/services/send-api.service.ts`).
  The SDK has the same calls behind the flag `pm-30110-sdk-sends-api`, off by
  default and not turned on by NodeWarden.

  No body, read as `SendResponse`.
}

tests {
  test("the owner removes the password", function () {
    expect(res.status).to.equal(200);
    expect(res.body.password == null).to.equal(true);
  });
}
