meta {
  name: POST sends/access with the Send token
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/sends/access
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{sendAccessToken}}
}

docs {
  Client: `SendApiService` (`libs/common/src/tools/send/services/send-api.service.ts`).
  The SDK has the same calls behind the flag `pm-30110-sdk-sends-api`, off by
  default and not turned on by NodeWarden. `postSendAccess` sends no body, the Send token as the bearer, and reads
  `SendAccessResponse`: Id, Type, Name, Text or File, ExpirationDate,
  CreatorIdentifier.
}

tests {
  test("the recipient opens the Send", function () {
    expect(res.status).to.equal(200);
    expect(res.body.type).to.equal(0);
    expect(res.body.name).to.be.a("string");
    expect(res.body.text).to.be.an("object");
  });
}
