meta {
  name: POST sends (with a password)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/sends
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerToken}}
}

body:json {
  {
    "type": 0,
    "name": "2.aXYtc2VuZA==|Y3Qtc2VuZA==|bWFjLWc2VuZA==",
    "notes": null,
    "key": "2.aXYtc2VuZC1rZXk=|Y3Qtc2VuZC1rZXk=|bWFjLWc2VuZC1rZXk=",
    "maxAccessCount": null,
    "expirationDate": null,
    "deletionDate": "{{sendDeletionDate}}",
    "text": {
      "text": "2.aXYtdGV4dA==|Y3QtdGV4dA==|bWFjLWdGV4dA==",
      "hidden": false
    },
    "file": null,
    "password": "{{sendPasswordHash}}",
    "emails": null,
    "authType": 1,
    "disabled": false,
    "hideEmail": false
  }
}

script:post-response {
  bru.setVar("sendPasswordId", res.body && res.body.id);
}

tests {
  test("the owner creates a Send behind a password", function () {
    expect(res.status).to.equal(200);
    expect(res.body.password).to.be.a("string");
  });
}
