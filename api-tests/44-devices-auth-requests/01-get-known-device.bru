meta {
  name: GET devices/knowndevice
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/devices/knowndevice
  body: none
  auth: none
}

headers {
  X-Device-Identifier: contract-ownerToken
  X-Request-Email: Y29udHJhY3Qtb3duZXJAZXhhbXBsZS50ZXN0
}

docs {
  Client: `DevicesApiServiceImplementation`
  (`libs/common/src/auth/services/devices-api.service.implementation.ts`). `getKnownDevice`, sent without a token before login, with the device
  in `X-Device-Identifier` and the email, base64url, in `X-Request-Email`. Read
  as a bare boolean.
}

tests {
  test("a device that logged in before is known", function () {
    expect(res.status).to.equal(200);
    expect(res.body).to.equal(true);
  });
}
