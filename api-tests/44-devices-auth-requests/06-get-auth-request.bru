meta {
  name: GET auth-requests/:id
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/auth-requests/{{authRequestId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ownerToken}}
}

docs {
  Client: `AuthRequestApiService`
  (`libs/auth/src/common/services/auth-request/auth-request-api.service.ts`) and
  `ApiService` auth request calls. Read as `AuthRequestResponse`: Id, PublicKey, RequestDeviceType,
  RequestDeviceIdentifier, RequestIpAddress, Key, RequestApproved,
  CreationDate, ResponseDate.
}

tests {
  const f = (o, k) => (o == null ? undefined : o[k] !== undefined ? o[k] : o[k.charAt(0).toUpperCase() + k.slice(1)]);
  test("the logged-in device reads the request", function () {
    expect(res.status).to.equal(200);
    expect(f(res.body, "publicKey")).to.equal("bmV3LWRldmljZS1wdWJsaWMta2V5");
  });
}
