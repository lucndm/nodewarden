meta {
  name: POST webauthn/:id/delete for an unknown passkey
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/api/webauthn/{{orgId}}/delete
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerToken}}
}

body:json {
  {
    "masterPasswordHash": "{{ownerPasswordHash}}"
  }
}

docs {
  Client: `WebAuthnLoginAdminApiService`
  (`apps/web/src/app/auth/core/services/webauthn-login/webauthn-login-admin-api.service.ts`):
  the passkeys an account logs in with, managed from the web vault settings. `deleteCredential`, body `SecretVerificationRequest`.
}

tests {
  test("an unknown passkey is not found", function () {
    expect(res.status).to.equal(404);
  });
}
