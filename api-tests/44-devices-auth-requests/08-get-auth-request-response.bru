meta {
  name: GET auth-requests/:id/response
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/auth-requests/{{authRequestId}}/response?code=contract-access-code
  body: none
  auth: none
}

docs {
  Client: `AuthRequestApiService`
  (`libs/auth/src/common/services/auth-request/auth-request-api.service.ts`) and
  `ApiService` auth request calls. The new device polls it without a token, with its access code, until
  the request is answered.
}

tests {
  const f = (o, k) => (o == null ? undefined : o[k] !== undefined ? o[k] : o[k.charAt(0).toUpperCase() + k.slice(1)]);
  test("the new device sees the approval and the wrapped key", function () {
    expect(res.status).to.equal(200);
    expect(f(res.body, "requestApproved")).to.equal(true);
    expect(f(res.body, "key")).to.equal(bru.getVar("wrappedDeviceKey"));
  });
}
