meta {
  name: POST auth-requests (ask to log in from a new device)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/auth-requests/
  body: json
  auth: none
}

headers {
  Device-Identifier: contract-new-device
}

body:json {
  {
    "email": "{{ownerEmail}}",
    "publicKey": "bmV3LWRldmljZS1wdWJsaWMta2V5",
    "deviceIdentifier": "contract-new-device",
    "accessCode": "contract-access-code",
    "type": 0
  }
}

script:post-response {
  const f = (o, k) => (o == null ? undefined : o[k] !== undefined ? o[k] : o[k.charAt(0).toUpperCase() + k.slice(1)]);
  bru.setVar("authRequestId", f(res.body, "id"));
}

docs {
  Client: `AuthRequestApiService`
  (`libs/auth/src/common/services/auth-request/auth-request-api.service.ts`) and
  `ApiService` auth request calls. `postAuthRequest`, sent without a token from the device that wants to
  log in, with `Device-Identifier`. Body `AuthRequest`: email, publicKey,
  deviceIdentifier, accessCode, type (0 login with device). Read as
  `AuthRequestResponse`.
}

tests {
  const f = (o, k) => (o == null ? undefined : o[k] !== undefined ? o[k] : o[k.charAt(0).toUpperCase() + k.slice(1)]);
  test("a new device asks to log in", function () {
    expect(res.status).to.equal(200);
    expect(f(res.body, "id")).to.be.a("string");
  });
}
