meta {
  name: PUT auth-requests/:id (approve)
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/api/auth-requests/{{authRequestId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerToken}}
}

body:json {
  {
    "key": "{{wrappedDeviceKey}}",
    "masterPasswordHash": null,
    "deviceIdentifier": "contract-ownerToken",
    "requestApproved": true
  }
}

docs {
  Client: `AuthRequestApiService`
  (`libs/auth/src/common/services/auth-request/auth-request-api.service.ts`) and
  `ApiService` auth request calls. Body `PasswordlessAuthRequest`: key (the user key wrapped with the
  request's public key), masterPasswordHash, deviceIdentifier (the approving
  device), requestApproved. Read as `AuthRequestResponse`.
}

tests {
  const f = (o, k) => (o == null ? undefined : o[k] !== undefined ? o[k] : o[k.charAt(0).toUpperCase() + k.slice(1)]);
  test("the logged-in device approves the request", function () {
    expect(res.status).to.equal(200);
    expect(f(res.body, "requestApproved")).to.equal(true);
  });
}
