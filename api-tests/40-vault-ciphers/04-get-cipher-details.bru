meta {
  name: GET ciphers/:id/details
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/ciphers/{{cipherAId}}/details
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ownerToken}}
}

docs {
  Client: `ApiService.getFullCipherDetails`, read as `CipherResponse` with
  `collectionIds`.
}

tests {
  test("the owner reads the item details", function () {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("collectionIds");
  });
}
