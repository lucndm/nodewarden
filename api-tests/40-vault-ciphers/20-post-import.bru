meta {
  name: POST ciphers/import
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/api/ciphers/import
  body: json
  auth: bearer
}

auth:bearer {
  token: {{memberToken}}
}

body:json {
  {
    "folders": [
      {
        "name": "2.aXYtaW1wb3J0|Y3QtaW1wb3J0|bWFjLWaW1wb3J0"
      }
    ],
    "ciphers": [
      {
        "type": 1,
        "name": "2.aXYtaW1wb3J0ZWQ=|Y3QtaW1wb3J0ZWQ=|bWFjLWaW1wb3J0ZWQ=",
        "notes": null,
        "favorite": false,
        "reprompt": 0,
        "folderId": null,
        "organizationId": null,
        "key": null,
        "login": {
          "username": "2.aXYtdXNlcg==|Y3QtdXNlcg==|bWFjLWdXNlcg==",
          "password": "2.aXYtcGFzcw==|Y3QtcGFzcw==|bWFjLWcGFzcw==",
          "uris": [],
