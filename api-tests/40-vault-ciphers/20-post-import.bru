}

docs {
  Client: `ImportApiService.postImportCiphers`
  (`libs/importer/src/services/import-api.service.ts`) and the SDK importer. Body
  `ImportCiphersRequest`: `folders`, `ciphers`, `folderRelationships` (cipher
  index to folder index). No response body read.
}

tests {
  test("an account imports items into a folder", function () {
    // send() treats 200, 201 and 204 as success when no body is read.
    expect([200, 204]).to.include(res.status);
  });
}
