meta {
  name: PUT ciphers/move
  type: http
  seq: 10
}

put {
  url: {{baseUrl}}/api/ciphers/move
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerToken}}
}

body:json {
  {
    "ids": [
      "{{cipherAId}}",
      "{{cipherBId}}"
    ],
    "folderId": "{{moveFolderId}}"
  }
}

docs {
  Client: the Rust SDK (`@bitwarden/sdk-internal` 0.2.0-main.1214, source
  `bitwarden/sdk-internal` at `5b7fbb41`), called from
  `libs/common/src/vault/services/cipher-sdk.service.ts`. The TypeScript client
  has no other path for this call.

  Body `CipherBulkMoveRequestModel` (`ids`, `folderId`), no response body read.
}

tests {
  test("the owner moves two items into the folder", function () {
    // send() treats 200, 201 and 204 as success when no body is read.
    expect([200, 204]).to.include(res.status);
  });
}
