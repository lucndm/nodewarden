meta {
  name: PUT ciphers/archive
  type: http
  seq: 12
}

put {
  url: {{baseUrl}}/api/ciphers/archive
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerToken}}
}

body:json {
  {
    "ids": [
      "{{cipherBId}}"
    ]
  }
}

docs {
  Client: `DefaultCipherArchiveService.archiveWithServer`
  (`libs/common/src/vault/services/default-cipher-archive.service.ts`), body
  `CipherBulkArchiveRequest` (`ids`), read as a `ListResponse` of
  `CipherResponse`.
}

tests {
  test("the owner archives the item", function () {
    expect(res.status).to.equal(200);
    const row = (res.body.data || [])[0];
    expect(row.archivedDate).to.be.a("string");
  });
}
