meta {
  name: GET ciphers/:id after the move
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/api/ciphers/{{cipherBId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ownerToken}}
}

tests {
  test("the item is in the folder", function () {
    expect(res.status).to.equal(200);
    expect(res.body.folderId).to.equal(bru.getVar("moveFolderId"));
  });
}
