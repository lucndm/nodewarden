meta {
  name: PUT ciphers/:id/partial
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/api/ciphers/{{cipherAId}}/partial
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerToken}}
}

body:json {
  {
    "folderId": null,
    "favorite": true
  }
}

docs {
  Client: the Rust SDK (`@bitwarden/sdk-internal` 0.2.0-main.1214, source
  `bitwarden/sdk-internal` at `5b7fbb41`), called from
  `libs/common/src/vault/services/cipher-sdk.service.ts`. The TypeScript client
  has no other path for this call.

  Body `CipherPartialRequestModel` (`folderId`, `favorite`): the fields a user
  changes on an item they can only read.
}

tests {
  test("the owner marks the item as a favorite", function () {
    expect(res.status).to.equal(200);
    expect(res.body.favorite).to.equal(true);
  });
}
