meta {
  name: PUT users/:id/revoke
  type: http
  seq: 10
}

put {
  url: {{baseUrl}}/api/organizations/{{adminOrgId}}/users/{{adminMemberMid}}/revoke
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ownerToken}}
}

docs {
  Client: `DefaultOrganizationUserApiService`
  (`libs/admin-console/src/common/organization-user/services/default-organization-user-api.service.ts`). `revokeOrganizationUser`, no body: the member keeps the account but
  loses access until restored.
}

tests {
  const f = (o, k) => (o == null ? undefined : o[k] !== undefined ? o[k] : o[k.charAt(0).toUpperCase() + k.slice(1)]);
  test("the owner revokes the member", function () {
    expect([200, 204]).to.include(res.status);
  });
}
