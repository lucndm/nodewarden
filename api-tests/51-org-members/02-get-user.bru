meta {
  name: GET users/:id
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/organizations/{{adminOrgId}}/users/{{adminMemberMid}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ownerToken}}
}

docs {
  Client: `DefaultOrganizationUserApiService`
  (`libs/admin-console/src/common/organization-user/services/default-organization-user-api.service.ts`). `getOrganizationUser`, read as `OrganizationUserDetailsResponse`
  (the member with Collections, Groups, Permissions). The edit dialog opens
  with it.
}

tests {
  const f = (o, k) => (o == null ? undefined : o[k] !== undefined ? o[k] : o[k.charAt(0).toUpperCase() + k.slice(1)]);
  test("the owner reads one member", function () {
    expect(res.status).to.equal(200);
    expect(f(res.body, "id")).to.equal(bru.getVar("adminMemberMid"));
    expect(f(res.body, "status")).to.equal(2);
  });
}
