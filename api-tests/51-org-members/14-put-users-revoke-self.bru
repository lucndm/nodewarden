}

put {
  url: {{baseUrl}}/api/organizations/{{adminOrgId}}/users/revoke-self
  body: none
  auth: bearer
}

auth:bearer {
  token: {{memberToken}}
}

docs {
  Client: `DefaultOrganizationUserApiService`
  (`libs/admin-console/src/common/organization-user/services/default-organization-user-api.service.ts`). `revokeSelf`, no body: a member who refuses a policy (for example the
  single-organization policy) revokes their own access instead of leaving.
}

tests {
  const f = (o, k) => (o == null ? undefined : o[k] !== undefined ? o[k] : o[k.charAt(0).toUpperCase() + k.slice(1)]);
  test("a member revokes their own access", function () {
    expect([200, 204]).to.include(res.status);
