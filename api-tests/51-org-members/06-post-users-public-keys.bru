meta {
  name: POST users/public-keys
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/organizations/{{adminOrgId}}/users/public-keys
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerToken}}
}

body:json {
  {
    "ids": [
      "{{adminMemberMid}}"
    ]
  }
}

docs {
  Client: `DefaultOrganizationUserApiService`
  (`libs/admin-console/src/common/organization-user/services/default-organization-user-api.service.ts`). `postOrganizationUsersPublicKey`, body `OrganizationUserBulkRequest`
  (`ids`), read as a list of `OrganizationUserBulkPublicKeyResponse` (Id, UserId,
  Key). The admin's client wraps the organization key with each public key
  before confirming.

  NodeWarden has `POST /users/public-key` (singular) with `userIds`.
}

tests {
  const f = (o, k) => (o == null ? undefined : o[k] !== undefined ? o[k] : o[k.charAt(0).toUpperCase() + k.slice(1)]);
  test("the owner reads the members' public keys", function () {
    expect(res.status).to.equal(200);
    const row = (f(res.body, "data") || [])[0];
    expect(f(row, "id")).to.equal(bru.getVar("adminMemberMid"));
    expect(f(row, "key")).to.be.a("string");
  });
}
