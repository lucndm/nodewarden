meta {
  name: POST users/confirm (bulk)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/organizations/{{adminOrgId}}/users/confirm
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerToken}}
}

body:json {
  {
    "keys": [
      {
        "id": "{{adminInviteeMid}}",
        "key": "{{wrappedOrgKey}}"
      }
    ],
    "defaultUserCollectionName": null
  }
}

docs {
  Client: `DefaultOrganizationUserApiService`
  (`libs/admin-console/src/common/organization-user/services/default-organization-user-api.service.ts`). `postOrganizationUserBulkConfirm`, body
  `OrganizationUserBulkConfirmRequest` (`keys`: id and wrapped key per member),
  read as a list of `OrganizationUserBulkResponse` (Id, Error). The invitee has
  not accepted, so the official server reports an error for that row instead of
  failing the call.
}

tests {
  const f = (o, k) => (o == null ? undefined : o[k] !== undefined ? o[k] : o[k.charAt(0).toUpperCase() + k.slice(1)]);
  test("the bulk confirm answers per member", function () {
    expect(res.status).to.equal(200);
    const row = (f(res.body, "data") || [])[0];
    expect(f(row, "error")).to.be.a("string");
  });
}
