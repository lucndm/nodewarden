meta {
  name: GET users/mini-details
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/organizations/{{adminOrgId}}/users/mini-details
  body: none
  auth: bearer
}

auth:bearer {
  token: {{memberToken}}
}

docs {
  Client: `DefaultOrganizationUserApiService`
  (`libs/admin-console/src/common/organization-user/services/default-organization-user-api.service.ts`). `getAllMiniUserDetails`, read as a list of
  `OrganizationUserUserMiniResponse` (Id, UserId, Email, Name, Type, Status). A
  plain member's client uses it to show who an item is shared with.
}

tests {
  const f = (o, k) => (o == null ? undefined : o[k] !== undefined ? o[k] : o[k.charAt(0).toUpperCase() + k.slice(1)]);
  test("a member reads the short member list", function () {
    expect(res.status).to.equal(200);
    expect(f(res.body, "data")).to.be.an("array");
  });
}
