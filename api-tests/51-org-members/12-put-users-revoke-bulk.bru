meta {
  name: PUT users/revoke (bulk)
  type: http
  seq: 12
}

put {
  url: {{baseUrl}}/api/organizations/{{adminOrgId}}/users/revoke
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerToken}}
}

body:json {
  {
    "ids": [
      "{{adminMemberMid}}"
    ]
  }
}

docs {
  Client: `DefaultOrganizationUserApiService`
  (`libs/admin-console/src/common/organization-user/services/default-organization-user-api.service.ts`). `revokeManyOrganizationUsers`, body `OrganizationUserBulkRequest`, read as
  a list of `OrganizationUserBulkResponse`.

  A fixed segment such as `invite` also matches NodeWarden's
  `/users/:membershipId` route, which then answers "member not found"; so a
  404 here can come from that route and still mean the endpoint is missing.
}

tests {
  const f = (o, k) => (o == null ? undefined : o[k] !== undefined ? o[k] : o[k.charAt(0).toUpperCase() + k.slice(1)]);
  test("the owner revokes members in bulk", function () {
    expect(res.status).to.equal(200);
  });
  test("the answer lists one result per member", function () {
    const rows = f(res.body, "data");
    expect(rows).to.be.an("array");
    expect(rows.length).to.be.above(0);
    expect(f(rows[0], "id")).to.be.a("string");
  });
}
