meta {
  name: Log in the lifecycle account
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/identity/connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: password
  username: {{lifecycleEmail}}
  password: {{lifecyclePasswordHash}}
  scope: api offline_access
  client_id: web
  deviceIdentifier: contract-lifecycle
  deviceName: contract check
  deviceType: 9
}

script:post-response {
  if (res.status === 200) bru.setVar("lifecycleToken", res.body.access_token);
}

tests {
  test("the lifecycle account logs in", function () {
    expect(res.status).to.equal(200);
    expect(res.body.access_token).to.be.a("string");
  });
}
