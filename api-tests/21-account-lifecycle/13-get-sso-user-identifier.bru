meta {
  name: GET accounts/sso/user-identifier
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/api/accounts/sso/user-identifier
  body: none
  auth: bearer
}

auth:bearer {
  token: {{lifecycleToken}}
}

docs {
  Client: `ApiService.getSsoUserIdentifier`, read as a string. The web vault calls
  it to link an existing account to an organization's SSO.

  NodeWarden links SSO on routes of its own (`/api/settings/sso`,
  `/api/settings/sso/link`); vaultwarden has no such route either. NodeWarden answers 501 (decided
  2026-11-10).
}

tests {
  test("organization SSO is refused as not supported", function () {
    expect(res.status).to.equal(501);
  });
}
