meta {
  name: POST set-password
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/api/accounts/set-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{lifecycleToken}}
}

body:json {
  {
    "masterPasswordHash": "{{lifecycleNewPasswordHash}}",
    "key": "2.aXY=|Y3Q=|bWFj",
    "masterPasswordHint": "",
    "orgIdentifier": "contract",
    "keys": null,
    "kdf": 0,
    "kdfIterations": 600000
  }
}

docs {
  Client: `MasterPasswordApiService.setPassword`, body `SetPasswordRequest`. Sent
  by an account created through SSO that has no master password yet.

  NodeWarden decision: SSO requires linking an existing account, so no account
  lacks a master password; `router-authenticated.ts` answers 501.
}

tests {
  test("NodeWarden refuses on purpose: every account already has a master password", function () {
    expect(res.status).to.equal(501);
  });
}
