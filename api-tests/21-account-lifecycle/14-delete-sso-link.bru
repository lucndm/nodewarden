meta {
  name: DELETE accounts/sso/:organizationId
  type: http
  seq: 14
}

delete {
  url: {{baseUrl}}/api/accounts/sso/{{orgId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{lifecycleToken}}
}

docs {
  Client: `ApiService.deleteSsoUser`, no body, no response body read. Unlinks the
  account from an organization's SSO. NodeWarden links one SSO provider for the
  whole server (`DELETE /api/settings/sso`) and answers 501 here (decided
  2026-11-10).
}

tests {
  test("organization SSO is refused as not supported", function () {
    expect(res.status).to.equal(501);
  });
}
