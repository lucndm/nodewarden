meta {
  name: POST password (change the master password)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/accounts/password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{lifecycleToken}}
}

body:json {
  {
    "masterPasswordHash": "{{lifecyclePasswordHash}}",
    "masterPasswordHint": "contract hint",
    "authenticationData": {
      "salt": "{{lifecycleEmail}}",
      "kdf": {
        "kdfType": 0,
        "iterations": 600000
      },
      "masterPasswordAuthenticationHash": "{{lifecycleNewPasswordHash}}"
    },
    "unlockData": {
      "salt": "{{lifecycleEmail}}",
      "kdf": {
        "kdfType": 0,
        "iterations": 600000
      },
      "masterKeyWrappedUserKey": "2.aXYtbmV3LWtleQ==|Y3QtbmV3LWtleQ==|bWFjLW5ldy1rZXk="
    }
  }
}

docs {
  Client: `MasterPasswordApiService.postPassword`
  (`libs/common/src/auth/services/master-password/master-password-api.service.implementation.ts`),
  body `PasswordRequest`: `masterPasswordHash` (the current one),
  `authenticationData` (salt, kdf, masterPasswordAuthenticationHash),
  `unlockData` (salt, kdf, masterKeyWrappedUserKey), `masterPasswordHint`. No
  response body read.

  Reference: vaultwarden `post_password` takes the same fields and still reads the older
  `newMasterPasswordHash` and `key`.
}

tests {
  test("the account changes its master password", function () {
    expect(res.status).to.equal(200);
  });
}
