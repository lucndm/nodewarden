meta {
  name: POST two-factor/get-duo
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/two-factor/get-duo
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerToken}}
}

body:json {
  {
    "masterPasswordHash": "{{ownerPasswordHash}}"
  }
}

docs {
  Client: `DefaultTwoFactorApiService`
  (`libs/common/src/auth/two-factor/services/default-two-factor-api.service.ts`). `getTwoFactorDuo`, read as `TwoFactorDuoResponse` (Enabled, ClientId,
  ClientSecret, Host) and UserVerificationToken. `PUT /two-factor/duo`
  (`TwoFactorDuoUpdateRequest`: clientId, clientSecret, host,
  userVerificationToken) and `DELETE /two-factor/duo` complete it.

  Duo needs a Duo account and its API. vaultwarden supports it; NodeWarden
  answers 501 (decided 2026-11-10) and offers an authenticator app, YubiKey and
  WebAuthn instead.
}

tests {
  test("Duo is refused as not supported", function () {
    expect(res.status).to.equal(501);
  });
}
