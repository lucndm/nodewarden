meta {
  name: DELETE two-factor/webauthn/all
  type: http
  seq: 9
}

delete {
  url: {{baseUrl}}/api/two-factor/webauthn/all
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerToken}}
}

body:json {
  {
    "userVerificationToken": "{{webauthnVerificationToken}}"
  }
}

docs {
  Client: `DefaultTwoFactorApiService`
  (`libs/common/src/auth/two-factor/services/default-two-factor-api.service.ts`). `deleteTwoFactorWebAuthnAll`, body `TwoFactorWebAuthnDeleteAllRequest`
  (`userVerificationToken`): removes every WebAuthn key at once. NodeWarden has
  `DELETE /two-factor/webauthn` for one key.
}

tests {
  test("NodeWarden has a route for it", function () {
    expect([404, 501]).to.not.include(res.status);
  });
}
