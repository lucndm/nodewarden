meta {
  name: POST two-factor/get-recover
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/two-factor/get-recover
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerToken}}
}

body:json {
  {
    "masterPasswordHash": "{{ownerPasswordHash}}"
  }
}

docs {
  Client: `DefaultTwoFactorApiService`
  (`libs/common/src/auth/two-factor/services/default-two-factor-api.service.ts`). `getTwoFactorRecover`, read as `TwoFactorRecoverResponse` (Code).
}

tests {
  const f = (o, k) => (o == null ? undefined : o[k] !== undefined ? o[k] : o[k.charAt(0).toUpperCase() + k.slice(1)]);
  test("the owner reads the recovery code", function () {
    expect(res.status).to.equal(200);
    expect(f(res.body, "code")).to.be.a("string");
  });
}
