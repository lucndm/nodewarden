meta {
  name: GET collections
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/organizations/{{adminOrgId}}/collections
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ownerToken}}
}

docs {
  Client: `DefaultCollectionAdminService`
  (`libs/admin-console/src/common/collections/services/default-collection-admin.service.ts`)
  and `ApiService` collection calls (`libs/common/src/services/api.service.ts`). `getCollections`, read as a list of `CollectionResponse`.
}

tests {
  const f = (o, k) => (o == null ? undefined : o[k] !== undefined ? o[k] : o[k.charAt(0).toUpperCase() + k.slice(1)]);
  test("the owner lists the collections", function () {
    expect(res.status).to.equal(200);
  });
  test("the answer has the fields the client reads", function () {
    const fields = ["id","organizationId","name","externalId"];
    const missing = fields.filter((field) => f((f(res.body, "data") || [])[0], field) === undefined);
    expect(missing.length, "missing fields: " + missing.join(", ")).to.equal(0);
  });
}
