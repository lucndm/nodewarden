meta {
  name: GET groups/:id/details
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/organizations/{{adminOrgId}}/groups/{{adminGroupId}}/details
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ownerToken}}
}

docs {
  Client: `GroupApiService`
  (`apps/web/src/app/admin-console/organizations/core/services/group/group-api.service.ts`). `get`, read as `GroupDetailsResponse`. The edit dialog opens with it.
}

tests {
  const f = (o, k) => (o == null ? undefined : o[k] !== undefined ? o[k] : o[k.charAt(0).toUpperCase() + k.slice(1)]);
  test("the owner reads one group with its collections", function () {
    expect(res.status).to.equal(200);
  });
  test("the answer has the fields the client reads", function () {
    const fields = ["id","name","collections"];
    const missing = fields.filter((field) => f(res.body, field) === undefined);
    expect(missing.length, "missing fields: " + missing.join(", ")).to.equal(0);
  });
}
