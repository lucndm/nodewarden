meta {
  name: POST groups
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/organizations/{{adminOrgId}}/groups
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerToken}}
}

body:json {
  {
    "name": "Contract Group",
    "collections": [
      {
        "id": "{{adminCollectionId}}",
        "readOnly": true,
        "hidePasswords": false,
        "manage": false
      }
    ],
    "users": [
      "{{adminOwnerMid}}"
    ]
  }
}

script:post-response {
  const f = (o, k) => (o == null ? undefined : o[k] !== undefined ? o[k] : o[k.charAt(0).toUpperCase() + k.slice(1)]);
  bru.setVar("adminGroupId", f(res.body, "id"));
}

docs {
  Client: `GroupApiService`
  (`apps/web/src/app/admin-console/organizations/core/services/group/group-api.service.ts`). `save` for a new group, body `GroupRequest`, read as `GroupResponse`.
}

tests {
  const f = (o, k) => (o == null ? undefined : o[k] !== undefined ? o[k] : o[k.charAt(0).toUpperCase() + k.slice(1)]);
  test("the owner creates a group", function () {
    // send() reads the body of a 200 or a 201.
    expect([200, 201]).to.include(res.status);
  });
  test("the answer has the fields the client reads", function () {
    const fields = ["id","organizationId","name"];
    const missing = fields.filter((field) => f(res.body, field) === undefined);
    expect(missing.length, "missing fields: " + missing.join(", ")).to.equal(0);
  });
}
