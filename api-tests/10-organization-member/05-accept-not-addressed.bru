meta {
  name: POST users/:id/accept by an account it was not sent to
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/organizations/{{orgId}}/users/{{inviteeMembershipId}}/accept
  body: json
  auth: bearer
}

auth:bearer {
  token: {{memberToken}}
}

body:json {
  {
    "token": "not-a-real-invite-token"
  }
}

docs {
  Client: `DefaultOrganizationUserApiService.postOrganizationUserAccept` in
  `libs/admin-console/src/common/organization-user/services/default-organization-user-api.service.ts`.
  Body `OrganizationUserAcceptRequest`: `token` (required) and
  `resetPasswordKey` (only when account recovery auto-enrollment is on). No
  response body is read.

  The client takes `organizationId`, `organizationUserId`, `email` and
  `token` from the invite link (`DirectOrgInviteUrlParams` in
  `libs/common/src/auth/organization-invite/models/direct-organization-invite.ts`).

  Reference: vaultwarden `accept_invite` decodes the token as a signed claim
  and refuses when its email, organization or membership does not match.
  NodeWarden sends no email and issues no token, so the token is not checked
  (decided 2026-11-10, as for emergency access): the membership in the path
  has to be the caller's. Here the member, who holds another membership of the
  organization, tries the invitee's.
}

tests {
  test("only the invitee can accept the invitation", function () {
    expect(res.status).to.equal(404);
  });
}
